                "});\r",
                "\r",
                "pm.test(\"Acceso denegado con credenciales inválidas\", () => {\r",
                "    if (pm.response.code === 401) {\r",
                "        let data = pm.response.json();\r",
                "        pm.expect(data.detail).to.eql(\"Credenciales inválidas\");\r",
                "    }\r",
                "});"
