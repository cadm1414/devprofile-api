            "listen": "test",
            "script": {
              "id": "1263f377-dab7-4e4b-8185-02d23313e13c",
              "type": "text/javascript",
              "packages": {},
              "exec": [
                "pm.test(\"El status debe ser 200 y devolver datos del usuario\", () => {\r",
                "    if (pm.response.code !== 200) {\r",
                "        return; \r",
                "    }\r",
                "    let data = pm.response.json();\r",
                "    pm.expect(data).to.have.property(\"id\");\r",
                "    pm.expect(data).to.have.property(\"email\");\r",
                "    pm.expect(data).to.have.property(\"full_name\");\r",
                "});\r",
                "\r",
                "pm.test(\"Validación de errores de Token\", () => {\r",
                "    if (pm.response.code !== 401) {\r",
                "        return;\r",
                "    }\r",
                "\r",
                "    let data = pm.response.json();\r",
                "\r",
                "    if (data.detail === \"Token has expired\") {\r",
                "        pm.expect(data.code).to.eql(\"TOKEN_EXPIRED\");\r",
                "    }\r",
                "    else if (data.detail === \"Token missing\") {\r",
                "        pm.expect(data.detail).to.eql(\"Token missing\");\r",
                "    }\r",
                "    else if (data.detail === \"Invalid token\") {\r",
                "        pm.expect(data.detail).to.eql(\"Invalid token\");\r",
                "    }\r",
                "    else {\r",
                "        pm.expect.fail(`Respuesta inesperada: ${JSON.stringify(data)}`);\r",
                "    }\r",
                "});"
              ],
              "_lastExecutionId": "e9c2a773-e831-4d1b-b0f4-9dd8cdbb1aad"
            }
          }
