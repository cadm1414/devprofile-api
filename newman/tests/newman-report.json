                  "    }\r",
                  "    else if (data.detail === \"Invalid token\") {\r",
                  "        pm.expect(data.detail).to.eql(\"Invalid token\");\r",
                  "    }\r",
                  "    else {\r",
                  "        pm.expect.fail(`Respuesta inesperada: ${JSON.stringify(data)}`);\r",
                  "    }\r",
                  "});"
