                  "    pm.expect(data.detail).to.eql(\"User not found\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validación de errores de Token\", () => {\r",
                  "    if (pm.response.code !== 401) {\r",
                  "        return;\r",
                  "    }\r",
                  "\r",
                  "    let data = pm.response.json();\r",
                  "\r",
                  "    if (data.detail === \"Token has expired\") {\r",
                  "        pm.expect(data.code).to.eql(\"TOKEN_EXPIRED\");\r",
                  "    }\r",
                  "    else if (data.detail === \"Token missing\") {\r",
