{
	"info": {
		"_postman_id": "53b0b2d6-a0a5-4d1b-b993-c67c34f911d2",
		"name": "DEVPROFILE-API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "13645281"
	},
	"item": [
		{
			"name": "get-access",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"El status debe ser 200\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Debe contener access_token\", () => {\r",
							"    let data = pm.response.json();\r",
							"    pm.expect(data).to.have.property(\"access_token\");    \r",
							"    pm.collectionVariables.set(\"access_token\", data.access_token);\r",
							"});\r",
							"\r",
							"pm.test(\"Acceso denegado con credenciales inválidas\", () => {\r",
							"    if (pm.response.code === 401) {\r",
							"        let data = pm.response.json();\r",
							"        pm.expect(data.detail).to.eql(\"Credenciales inválidas\");\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\":\"test@gmail.com\",\r\n    \"password\":\"123qweasd\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://127.0.0.1:8000/api/v1/auth/access",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"auth",
						"access"
					]
				}
			},
			"response": []
		},
		{
			"name": "get-me",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"El status debe ser 200 y devolver datos del usuario\", () => {\r",
							"    if (pm.response.code !== 200) {\r",
							"        return; \r",
							"    }\r",
							"    let data = pm.response.json();\r",
							"    pm.expect(data).to.have.property(\"id\");\r",
							"    pm.expect(data).to.have.property(\"email\");\r",
							"    pm.expect(data).to.have.property(\"full_name\");\r",
							"});\r",
							"\r",
							"pm.test(\"Validación de errores de Token\", () => {\r",
							"    if (pm.response.code !== 401) {\r",
							"        return;\r",
							"    }\r",
							"\r",
							"    let data = pm.response.json();\r",
							"\r",
							"    if (data.detail === \"Token has expired\") {\r",
							"        pm.expect(data.code).to.eql(\"TOKEN_EXPIRED\");\r",
							"    }\r",
							"    else if (data.detail === \"Token missing\") {\r",
							"        pm.expect(data.detail).to.eql(\"Token missing\");\r",
							"    }\r",
							"    else if (data.detail === \"Invalid token\") {\r",
							"        pm.expect(data.detail).to.eql(\"Invalid token\");\r",
							"    }\r",
							"    else {\r",
							"        pm.expect.fail(`Respuesta inesperada: ${JSON.stringify(data)}`);\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwiZXhwIjoxNzU4NzE1Nzk4fQ.VVzYiLsNgsIyCRO2HTRNPV4EujNIg_9pUyGC5l4RvO",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/api/v1/identity/me",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"identity",
						"me"
					]
				}
			},
			"response": []
		}
	],
