# =============================================================================
# Variables de Entorno para Deployment Manual
# =============================================================================
# Este archivo contiene las variables necesarias para ejecutar deploy-manual.sh
# 
# Uso:
# 1. Copiar este archivo a .env.deploy
#    cp .env.deploy.example .env.deploy
# 
# 2. Completar los valores
# 
# 3. Ejecutar deployment
#    ./deploy-manual.sh
#
# ⚠️ IMPORTANTE: .env.deploy está en .gitignore, nunca lo commitees!
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos PostgreSQL
# -----------------------------------------------------------------------------
# Estos valores deben coincidir con terraform/terraform.tfvars

DB_NAME=devprofile_db
DB_USER=devprofile_user
DB_PASSWORD=TU_PASSWORD_POSTGRESQL_AQUI

# Generar password seguro:
# openssl rand -base64 24


# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Secret key para JWT tokens (REQUERIDO)
API_SECRET_KEY=TU_SECRET_KEY_AQUI

# Generar secret key:
# openssl rand -base64 32


# -----------------------------------------------------------------------------
# AWS Configuration (Opcional - se obtiene automáticamente de Terraform)
# -----------------------------------------------------------------------------

# Si Terraform no está disponible, puedes especificar manualmente:
# EC2_HOST=54.123.45.67

# SSH Key path (por defecto: ~/.ssh/devprofile-aws)
# SSH_KEY=/path/to/your/ssh-key


# -----------------------------------------------------------------------------
# Docker Configuration (Opcional)
# -----------------------------------------------------------------------------

# Nombre de la imagen Docker (por defecto: devprofile-api:latest)
# DOCKER_IMAGE=devprofile-api:v1.0.0


# =============================================================================
# Ejemplo Completo
# =============================================================================
#
# DB_NAME=devprofile_db
# DB_USER=devprofile_user
# DB_PASSWORD=XyZ123AbC456DeF789GhI012JkL345MnO678
# API_SECRET_KEY=dGhpc2lzYXN1cGVyc2VjcmV0a2V5Zm9yand0dG9rZW5zMTIzNDU2
# EC2_HOST=54.123.45.67
# SSH_KEY=/home/user/.ssh/devprofile-aws
# DOCKER_IMAGE=devprofile-api:latest
#
# =============================================================================
